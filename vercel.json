{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python scripts/prepare_vercel.py",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{.venv/**,.venv*/**,.npm-cache/**,.vercel-cli/**,.vercel/**,.git/**,macos/**,tests/**,public/**,src/bomboni/adapters/web/static/**,**/__pycache__/**,**/*.pyc,*.egg-info/**,src/bomboni.egg-info/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/restaurant-hours",
      "destination": "/api/restaurant_hours"
    },
    {
      "source": "/api/restaurants/:restaurantId/menu",
      "destination": "/api/menu?restaurant_id=:restaurantId"
    },
    {
      "source": "/api/mcp/:path*",
      "destination": "/api/mcp"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
